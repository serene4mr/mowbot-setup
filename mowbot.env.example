# Copy to /etc/mowbot.env (or run scripts/install.sh, which creates /etc/mowbot.env).
# Read by compose after stack.env: docker compose --env-file stack.env --env-file /etc/mowbot.env ...

# This file holds what is specific to this robot. Which software it runs is
# not: that is stack.env in the repository, one commit per release. Do not
# set MB_IMAGE_TAG, MB_GUI_IMAGE_TAG, the digests or MB_DATA_COMMIT here;
# update.sh warns if you do, because /etc/mowbot.env is read after stack.env
# and would silently override the release.

MB_ROBOT_ID=
MB_MANUFACTURER=
MB_ROBOT_MODEL=
MB_SENSOR_MODEL=

MB_MQTT_HOST=localhost
MB_MQTT_PORT=1883
MB_MQTT_USE_TLS=false
MB_MQTT_USER=
MB_MQTT_PASSWORD=

MB_DATA_PATH=/etc/mowbot_data
