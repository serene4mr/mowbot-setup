# Copy to /etc/mowbot.env (or run scripts/install.sh, which creates /etc/mowbot.env).
# Same file as systemd ExecStart: docker compose --env-file /etc/mowbot.env ...

# Full tag of the ROS image (ghcr.io/serene4mr/mowbot:<this>), e.g.
# devel-jetson-l4t-r36.4-v0.1.0. Pin a versioned tag built by the jetson
# workflow so the robot's source is reconstructable and an update or a
# rollback is one line here plus scripts/update.sh. The *-latest default in
# docker-compose.yml is for bench use only: it moves whenever anyone builds
# by hand and is not traceable to source.
MB_IMAGE_TAG=devel-jetson-l4t-r36.4-latest

MB_ROBOT_ID=
MB_MANUFACTURER=
MB_ROBOT_MODEL=
MB_SENSOR_MODEL=

MB_MQTT_HOST=localhost
MB_MQTT_PORT=1883
MB_MQTT_USE_TLS=false
MB_MQTT_USER=
MB_MQTT_PASSWORD=

MB_DATA_PATH=/etc/mowbot_data
