# The software this robot release consists of. One commit to this file is one
# robot release, and a git tag on that commit names it; update.sh applies
# whatever is checked out. Nothing here is per robot: identity (robot id and
# model, MQTT) lives in /etc/mowbot.env, which is never committed.
#
# Images are named by tag AND digest. The tag says which build; the digest
# proves it, because a tag can be moved and a digest cannot. Both come from
# the registry after the build:
#   docker buildx imagetools inspect ghcr.io/serene4mr/mowbot:<tag> --format '{{.Manifest.Digest}}'
# Change the tag and the digest of a component in the same commit.

# ROS stack (the four mowbot_* containers): ghcr.io/serene4mr/mowbot, built by
# the jetson workflow of the mowbot repository from releases/<version>.repos
# there; that file is baked into the image as /opt/mowbot/manifest.repos.
MB_IMAGE_TAG=devel-jetson-l4t-r36.4-v0.1.0-rc4
MB_IMAGE_DIGEST=sha256:2be05e0b254adfbf2aae25934b613e684f4ca098091104ca5679a32a3eeaf048

# Operator GUI: ghcr.io/serene4mr/mowbot-gui, tagged by its CI with the full
# commit of the mowbot-gui repository. Both ends of the GUI<->ROS link build on
# vda5050_client; move this together with MB_IMAGE_TAG when that library moves.
MB_GUI_IMAGE_TAG=08d859dd9159f55beccf3637fafa8386881cc770
MB_GUI_IMAGE_DIGEST=sha256:9aaea43a1efa10ad8f0a0a0b89bb5d8274e9b71fa4f25abb399962f13e2c4ee6

# Runtime data and config template checked out at /etc/mowbot_data: a commit
# of serene4mr/mowbot_data. update.sh checks it out and refuses to run over
# local changes there (see README, "Update").
MB_DATA_COMMIT=0acd7e2a933ad59f95a7b901657cf4fa4933d293

# Base controller firmware this release was soaked with. Not applied by
# update.sh (firmware is flashed with Mowbot Base ESP32 Setup); recorded so
# that the release describes the whole robot. "none" until a soak was done.
MB_FIRMWARE=none

# Not pinned yet: mowbot-utility-webui and kartoza/mapproxy still use :latest
# in docker-compose.yml.
